{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "git": { "deploymentEnabled": { "**": false, "main": true } },
  "crons": [{ "path": "/api/likes/cron", "schedule": "17 4 * * *" }],
  "redirects": [
    { "source": "/essay", "destination": "/blog/dot-matrix-essay/", "permanent": true },
    { "source": "/essay/", "destination": "/blog/dot-matrix-essay/", "permanent": true },
    { "source": "/essay.html", "destination": "/blog/dot-matrix-essay/", "permanent": true },
    { "source": "/glyph", "destination": "/lock/", "permanent": true },
    { "source": "/glyph/", "destination": "/lock/", "permanent": true },
    { "source": "/widget/glyph-:rest", "destination": "/widget/lock-:rest/", "permanent": true },
    { "source": "/widget/glyph-:rest/", "destination": "/widget/lock-:rest/", "permanent": true },
    { "source": "/widget/:key(cinema-last-call|cinema-closer|y6q3xhhe|ezrp10da)", "destination": "/cinema/", "permanent": true },
    { "source": "/widget/:key(cinema-last-call|cinema-closer|y6q3xhhe|ezrp10da)/", "destination": "/cinema/", "permanent": true },
    { "source": "/:uid(y6q3xhhe|ezrp10da)", "destination": "/cinema/", "permanent": true },
    { "source": "/:uid(y6q3xhhe|ezrp10da)/", "destination": "/cinema/", "permanent": true },
    { "source": "/widget/:key(mirror-ladder|nhneq04s)", "destination": "/mirror/", "permanent": true },
    { "source": "/widget/:key(mirror-ladder|nhneq04s)/", "destination": "/mirror/", "permanent": true },
    { "source": "/:uid(nhneq04s)", "destination": "/mirror/", "permanent": true },
    { "source": "/:uid(nhneq04s)/", "destination": "/mirror/", "permanent": true },
    { "source": "/widget/:key(surface-eink|surface-plotter|pbq54zfr|jfm4e97e)", "destination": "/surfaces/", "permanent": true },
    { "source": "/widget/:key(surface-eink|surface-plotter|pbq54zfr|jfm4e97e)/", "destination": "/surfaces/", "permanent": true },
    { "source": "/:uid(pbq54zfr|jfm4e97e)", "destination": "/surfaces/", "permanent": true },
    { "source": "/:uid(pbq54zfr|jfm4e97e)/", "destination": "/surfaces/", "permanent": true },
    { "source": "/materials", "destination": "/workshop/", "permanent": true },
    { "source": "/materials/", "destination": "/workshop/", "permanent": true },
    { "source": "/widget/:key(mat-loom|mat-knob|mat-grille|mat-marble|mat-terrazzo|mat-lens|mat-pool|mat-window|mat-patch|mat-rust|mat-candle|0t47ey59|9942tpm6|k6h584d5|cbmez41j|5wg1q77w|pe6dn0fm|bm0q7rq9|8705twys|6bka443r|gt231wn2|pymm8vf0)", "destination": "/workshop/", "permanent": true },
    { "source": "/widget/:key(mat-loom|mat-knob|mat-grille|mat-marble|mat-terrazzo|mat-lens|mat-pool|mat-window|mat-patch|mat-rust|mat-candle|0t47ey59|9942tpm6|k6h584d5|cbmez41j|5wg1q77w|pe6dn0fm|bm0q7rq9|8705twys|6bka443r|gt231wn2|pymm8vf0)/", "destination": "/workshop/", "permanent": true },
    { "source": "/:uid(0t47ey59|9942tpm6|k6h584d5|cbmez41j|5wg1q77w|pe6dn0fm|bm0q7rq9|8705twys|6bka443r|gt231wn2|pymm8vf0)", "destination": "/workshop/", "permanent": true },
    { "source": "/:uid(0t47ey59|9942tpm6|k6h584d5|cbmez41j|5wg1q77w|pe6dn0fm|bm0q7rq9|8705twys|6bka443r|gt231wn2|pymm8vf0)/", "destination": "/workshop/", "permanent": true },
    { "source": "/widget/:key(mat-knit|mat-denim|mat-paper|mat-wood|mat-leather|mat-sand|mat-mercury|mat-thread|mat-mud|mat-lichtenberg|mat-erosion|k8par51e|5ccpsd8c|ev8dqt4a|zv5k2rra|9q3kgrk7|ey87ejrb|qn7td5fx|rh733bmf|r9kvhax6|rxtyh8y2|2xeq5xxe)", "destination": "/workshop/", "permanent": true },
    { "source": "/widget/:key(mat-knit|mat-denim|mat-paper|mat-wood|mat-leather|mat-sand|mat-mercury|mat-thread|mat-mud|mat-lichtenberg|mat-erosion|k8par51e|5ccpsd8c|ev8dqt4a|zv5k2rra|9q3kgrk7|ey87ejrb|qn7td5fx|rh733bmf|r9kvhax6|rxtyh8y2|2xeq5xxe)/", "destination": "/workshop/", "permanent": true },
    { "source": "/:uid(k8par51e|5ccpsd8c|ev8dqt4a|zv5k2rra|9q3kgrk7|ey87ejrb|qn7td5fx|rh733bmf|r9kvhax6|rxtyh8y2|2xeq5xxe)", "destination": "/workshop/", "permanent": true },
    { "source": "/:uid(k8par51e|5ccpsd8c|ev8dqt4a|zv5k2rra|9q3kgrk7|ey87ejrb|qn7td5fx|rh733bmf|r9kvhax6|rxtyh8y2|2xeq5xxe)/", "destination": "/workshop/", "permanent": true },
    { "source": "/widget/sq-tetris", "destination": "/widget/sq-stack/", "permanent": true },
    { "source": "/widget/sq-tetris/", "destination": "/widget/sq-stack/", "permanent": true },
    { "source": "/widget/:key(thermal-puppy|05cze99w)", "destination": "/audio/", "permanent": true },
    { "source": "/widget/:key(thermal-puppy|05cze99w)/", "destination": "/audio/", "permanent": true },
    { "source": "/:uid(05cze99w)", "destination": "/audio/", "permanent": true },
    { "source": "/:uid(05cze99w)/", "destination": "/audio/", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "about" }], "destination": "/about/", "permanent": true },
    { "source": "/index.html", "has": [{ "type": "query", "key": "about" }], "destination": "/about/", "permanent": true },
    { "source": "/browse", "destination": "/", "permanent": true },
    { "source": "/browse/", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/ingest/static/:path*", "destination": "https://us-assets.i.posthog.com/static/:path*" },
    { "source": "/ingest/:path*", "destination": "https://us.i.posthog.com/:path*" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:path*", "destination": "/blog.html" },
    { "source": "/lab", "destination": "/lab/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/:board(henry|deerflow12|mosaic|henry3|metro|ride|audio|departures|instrument|ir|cinema|light|levels|heartbeat|sim|lock|live|mirror|gpu|surfaces|components|type|physics|scope|heal|algorithms|pond|workshop|squares|fractals|oldschool|scenes|dash|kinetic|faces|charts|motion|watch)", "destination": "/:board/index.html" },
    { "source": "/:about([Aa][Bb][Oo][Uu][Tt])", "destination": "/about/index.html" },
    { "source": "/:about([Aa][Bb][Oo][Uu][Tt])/", "destination": "/about/index.html" },
    { "source": "/widget/:key", "destination": "/index.html" },
    { "source": "/widget/:key/", "destination": "/index.html" },
    { "source": "/:scope(@[^/]+)/widget/:key", "destination": "/index.html" },
    { "source": "/:scope(@[^/]+)/widget/:key/", "destination": "/index.html" },
    { "source": "/:uid((?=(?:[^0-9/]*[0-9]){2})[0-9a-hjkmnp-tv-zA-HJKMNP-TV-Z]{8})", "destination": "/index.html" },
    { "source": "/:uid((?=(?:[^0-9/]*[0-9]){2})[0-9a-hjkmnp-tv-zA-HJKMNP-TV-Z]{8})/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-qQBIFTjCK4H1Obx3MCCxdvZbksrghU0/yu9rnkPhrKE='; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self' data:; connect-src 'self' https://api.open-meteo.com https://api.github.com https://github-contributions-api.jogruber.de; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "require-trusted-types-for 'script'; trusted-types dot480-svg default"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), accelerometer=(self), gyroscope=(self), geolocation=(), payment=(), bluetooth=(), usb=(), serial=(), hid=(), display-capture=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/r/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.svg|icons/.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
