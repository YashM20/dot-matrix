{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "git": { "deploymentEnabled": { "**": false, "main": true } },
  "crons": [{ "path": "/api/likes/cron", "schedule": "17 4 * * *" }],
  "redirects": [
    { "source": "/essay", "destination": "/blog/dot-matrix-essay/", "permanent": true },
    { "source": "/essay/", "destination": "/blog/dot-matrix-essay/", "permanent": true },
    { "source": "/essay.html", "destination": "/blog/dot-matrix-essay/", "permanent": true },
    { "source": "/glyph", "destination": "/lock/", "permanent": true },
    { "source": "/glyph/", "destination": "/lock/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/ingest/static/:path*", "destination": "https://us-assets.i.posthog.com/static/:path*" },
    { "source": "/ingest/:path*", "destination": "https://us.i.posthog.com/:path*" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:path*", "destination": "/blog.html" },
    { "source": "/lab", "destination": "/lab/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/:board(henry|deerflow12|mosaic|henry3|metro|ride|audio|departures|instrument|ir|cinema|light|levels|heartbeat|sim|lock|live|mirror|gpu|surfaces|components|type|physics|scope|heal|algorithms|materials|pond|workshop|squares|fractals|oldschool|scenes|dash|kinetic|faces|charts|motion|watch)", "destination": "/:board/index.html" },
    { "source": "/browse", "destination": "/browse/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/about/", "destination": "/index.html" },
    { "source": "/widget/:key", "destination": "/index.html" },
    { "source": "/widget/:key/", "destination": "/index.html" },
    { "source": "/:scope(@[^/]+)/widget/:key", "destination": "/index.html" },
    { "source": "/:scope(@[^/]+)/widget/:key/", "destination": "/index.html" },
    { "source": "/:uid((?=(?:[^0-9/]*[0-9]){2})[0-9a-hjkmnp-tv-zA-HJKMNP-TV-Z]{8})", "destination": "/index.html" },
    { "source": "/:uid((?=(?:[^0-9/]*[0-9]){2})[0-9a-hjkmnp-tv-zA-HJKMNP-TV-Z]{8})/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-8JD4uTl/DOhh+wkmMK+00WQpbP6zno2IQFlVuJxG5lU='; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; font-src 'self' data:; connect-src 'self' https://api.open-meteo.com https://api.github.com https://github-contributions-api.jogruber.de; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "require-trusted-types-for 'script'; trusted-types dot480-svg default"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), accelerometer=(self), gyroscope=(self), geolocation=(), payment=(), bluetooth=(), usb=(), serial=(), hid=(), display-capture=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/r/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
