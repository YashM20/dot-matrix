<!-- Dot/480 Private Plugin markup (layout: half_horizontal). Same polled JSON as full.liquid. -->
<div class="view view--half_horizontal">
  <div class="layout layout--center">
    <img src="{{ image_url }}" alt="{{ title }}" style="height: 100%; object-fit: contain; image-rendering: pixelated;" />
  </div>
  <div class="title_bar">
    <span class="title">Dot/480</span>
    <span class="instance">{{ title }}</span>
  </div>
</div>
