{
  "name": "dot-matrix",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify": "tsx scripts/verify.ts",
    "snap": "tsx scripts/snap.ts",
    "golden": "tsx scripts/golden.ts",
    "og:blog": "tsx scripts/og-blog.ts",
    "fidelity": "tsx scripts/fidelity.ts",
    "bench": "tsx scripts/bench.ts",
    "shots": "tsx scripts/site/shots.ts",
    "a11y": "tsx scripts/site/a11y.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "pnpm check:static && pnpm verify",
    "check:static": "tsc -b && oxlint && tsx scripts/site/file-size.ts && tsx scripts/site/credits.ts --check && tsx scripts/site/favicon.ts --check && tsx scripts/site/headers.ts && tsx scripts/site/urls.ts && tsx scripts/site/prose-lint.ts && tsx scripts/site/analytics.ts"
  },
  "dependencies": {
    "@fontsource-variable/oxanium": "^5.3.0",
    "botid": "1.5.12",
    "posthog-js": "^1.445.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.4"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2"
    }
  }
}
